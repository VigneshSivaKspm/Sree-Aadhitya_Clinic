# Firebase web app config (Firebase console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Public URL of this site (used for canonical links / Open Graph). No trailing slash.
VITE_SITE_URL=http://localhost:5173

# Sample/demo content is shown ONLY while Firestore collections are empty.
#   true  -> always allow demo fallback (e.g. staging)
#   false -> never show demo content (set this in production)
#   unset -> demo fallback in `npm run dev` only
VITE_ENABLE_DEMO_DATA=
